# Database
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USERNAME=root
DATABASE_PASSWORD=
DATABASE_NAME=real_estate_mvp

# JWT
JWT_SECRET=change-me-to-a-secure-secret
JWT_EXPIRATION_TIME=3600
JWT_REFRESH_SECRET=change-me-to-a-secure-refresh-secret
JWT_REFRESH_EXPIRATION_TIME=604800

# MFA
MFA_TOKEN_EXPIRATION_MINUTES=5
MFA_TOKEN_LENGTH=6

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# Mail (SMTP)
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=noreply@example.com
MAIL_PASSWORD=your-smtp-password
MAIL_FROM=noreply@example.com

# App
APP_PORT=3001
APP_CORS_ORIGIN=http://localhost:3000
APP_TIMEZONE=America/Sao_Paulo

# Bucket (S3 compatible, Railway Bucket credentials tab)
BUCKET_URL=https://t3.storageapi.dev
BUCKET_NAME=
BUCKET_KEY=
BUCKET_SECRET=
BUCKET_REGION=auto
BUCKET_FORCE_PATH_STYLE=false
# Sites allowed to upload straight to the bucket, defaults to APP_FRONTEND_URL and APP_CORS_ORIGIN
BUCKET_CORS_ORIGINS=


# Frontend address used in the property links sent by WhatsApp
APP_FRONTEND_URL=http://localhost:3000

# Evolution API (WhatsApp)
EVOLUTION_API_URL=https://evolution.example.com
EVOLUTION_API_KEY=
# Public address of this backend, Evolution posts the webhooks to /webhooks/evolution/:token
EVOLUTION_WEBHOOK_BASE_URL=https://backend.example.com
EVOLUTION_INSTANCE_PREFIX=brokerin
# WhatsApp anti ban safety, every send of a number goes through one queue. Optional, the values below are the defaults, 0 turns a limit off
WHATSAPP_CHAT_SWITCH_DELAY_MINIMUM_MS=4000
WHATSAPP_CHAT_SWITCH_DELAY_MAXIMUM_MS=9000
WHATSAPP_SAME_CHAT_DELAY_MINIMUM_MS=1200
WHATSAPP_SAME_CHAT_DELAY_MAXIMUM_MS=3000
WHATSAPP_TYPING_MINIMUM_MS=800
WHATSAPP_TYPING_MAXIMUM_MS=4000
WHATSAPP_MESSAGES_PER_MINUTE=12
WHATSAPP_MESSAGES_PER_HOUR=150
WHATSAPP_MESSAGES_PER_DAY=600
WHATSAPP_NEW_CHATS_PER_HOUR=10
WHATSAPP_NEW_CHATS_PER_DAY=30
WHATSAPP_SAME_TEXT_CHATS_PER_DAY=5
WHATSAPP_WARM_UP_HOURS=48
WHATSAPP_WARM_UP_FACTOR=0.5
WHATSAPP_MAXIMUM_QUEUED_MESSAGES=80
WHATSAPP_FAILURES_BEFORE_PAUSE=3
WHATSAPP_PAUSE_MS=120000
WHATSAPP_LOOKUPS_PER_HOUR=120
WHATSAPP_LOOKUP_DELAY_MINIMUM_MS=1500
WHATSAPP_LOOKUP_DELAY_MAXIMUM_MS=3500
WHATSAPP_CONNECT_ATTEMPTS=5

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=low
# What OpenAI charges per one million tokens, check https://openai.com/api/pricing
OPENAI_INPUT_COST_PER_MILLION_USD=0.10
OPENAI_OUTPUT_COST_PER_MILLION_USD=0.50
# Voice messages sent to the assistant
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_TRANSCRIPTION_AUDIO_COST_PER_MILLION_USD=3
OPENAI_TRANSCRIPTION_TEXT_COST_PER_MILLION_USD=5
# Used when the model bills by the minute, like whisper-1
OPENAI_TRANSCRIPTION_COST_PER_MINUTE_USD=0.006
# Owner hunt searches the listing sites, each web search is billed apart
OPENAI_WEB_SEARCH_COST_PER_CALL_USD=0.01
# Web search does not run with minimal reasoning, this effort is used instead
OPENAI_WEB_SEARCH_REASONING_EFFORT=low

# AI credits (prepaid)
# Price charged over the AI cost, never lower than 3
CREDITS_PROFIT_MULTIPLIER=3
# Keep it above the real exchange rate to protect the margin
CREDITS_USD_TO_BRL_RATE=6
# Header x-admin-key for POST /credits/grants
CREDITS_ADMIN_KEY=

# Mercado Pago, Your integrations > your app > Production credentials
# Empty turns billing off: nobody is blocked nor limited by plan until it is set
MERCADO_PAGO_ACCESS_TOKEN=
# Public key of the same app, loads the secure card form in the browser. Empty turns card payments off
MERCADO_PAGO_PUBLIC_KEY=
# Public address of this backend, Mercado Pago posts to /webhooks/mercado-pago
MERCADO_PAGO_NOTIFICATION_BASE_URL=https://backend.example.com
# Your integrations > your app > Webhooks: point it to the same {MERCADO_PAGO_NOTIFICATION_BASE_URL}/webhooks/mercado-pago,
# tick "Pagamentos" and "Planos e assinaturas" and paste the secret signature here
MERCADO_PAGO_WEBHOOK_SECRET=

# Subscription plans (prices in reais, credits given on every paid month)
SUBSCRIPTION_TRIAL_DAYS=7
SUBSCRIPTION_GRACE_DAYS=7
# Pix renewal opens this many days before the paid month ends
SUBSCRIPTION_RENEWAL_WINDOW_DAYS=10
PLAN_BASIC_PRICE_IN_BRL=69.90
PLAN_BASIC_MONTHLY_CREDITS=500
PLAN_RECOMMENDED_PRICE_IN_BRL=129.90
PLAN_RECOMMENDED_MONTHLY_CREDITS=1000
PLAN_PREMIUM_PRICE_IN_BRL=249.90
PLAN_PREMIUM_MONTHLY_CREDITS=3000

# AI property hunt on the listing portals (ZAP, Viva Real, QuintoAndar, OLX...)
# Encrypts the portal passwords and sessions, generate with: openssl rand -hex 32
# Never change it after brokers connect their accounts, or they must connect again
PORTAL_CREDENTIALS_SECRET=
# Remote Chrome, as Browserless (wss://...?token=...). Preferred when set
PORTAL_BROWSER_WS_ENDPOINT=
# Local Chrome or Chromium, found on its own when empty (/usr/bin/chromium)
# On Railway, set RAILPACK_DEPLOY_APT_PACKAGES=chromium to install it
PORTAL_BROWSER_EXECUTABLE_PATH=
PORTAL_BROWSER_HEADLESS=true
# Listings opened and read by the AI on each portal of a hunt (1 to 30)
PORTAL_LISTINGS_PER_PORTAL=10
# Pause between pages of the same portal
PORTAL_PAGE_DELAY_MILLISECONDS=2500
# Hunts running at the same time on this server
PORTAL_CONCURRENT_HUNTS=1

# Public certificates (CND federal, CNDT...) fetched for the broker through Infosimples
# Token from https://infosimples.com, leave empty to only show the portal links
INFOSIMPLES_TOKEN=
INFOSIMPLES_BASE_URL=https://api.infosimples.com/api/v2/consultas
# Seconds Infosimples keeps trying the portal (15 to 600)
INFOSIMPLES_TIMEOUT_SECONDS=120
# Usual cost of one query in reais, shown before the search. The real price answered is the one charged, times CREDITS_PROFIT_MULTIPLIER
INFOSIMPLES_ESTIMATED_COST_IN_BRL=0.5

# Daily briefing: the AI writes every broker a free summary at 8h (Brasília). Set false on local copies of production data
DAILY_BRIEFING_SCHEDULE_ENABLED=true
