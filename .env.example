# Database
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USERNAME=root
DATABASE_PASSWORD=
DATABASE_NAME=real_estate_mvp

# JWT
JWT_SECRET=change-me-to-a-secure-secret
JWT_EXPIRATION_TIME=3600
JWT_REFRESH_SECRET=change-me-to-a-secure-refresh-secret
JWT_REFRESH_EXPIRATION_TIME=604800

# MFA
MFA_TOKEN_EXPIRATION_MINUTES=5
MFA_TOKEN_LENGTH=6

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# Mail (SMTP)
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=noreply@example.com
MAIL_PASSWORD=your-smtp-password
MAIL_FROM=noreply@example.com

# App
APP_PORT=3001
APP_CORS_ORIGIN=http://localhost:3000
APP_TIMEZONE=America/Sao_Paulo

# Redis (required for WhatsApp message queue)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# WhatsApp / Meta Cloud API
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
META_API_VERSION=v22.0
META_WEBHOOK_VERIFY_TOKEN=your-random-verify-token
WHATSAPP_ENCRYPTION_KEY=your-base64-32-byte-key
